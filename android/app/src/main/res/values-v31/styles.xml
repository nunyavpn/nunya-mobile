<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own launch screen, the icon on windowSplashScreenBackground, before
         any app code runs. Its ground is the splash's, so the hand-off to lib/splash.dart is seamless. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_ground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
